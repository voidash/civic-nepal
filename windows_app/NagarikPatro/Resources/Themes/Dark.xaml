<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="PopupBackground"          Color="#1F1F1F"/>
    <SolidColorBrush x:Key="DividerBrush"             Color="#3D3D3D"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ClockForeground"          Color="White"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"         Color="White"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"       Color="#9D9D9D"/>
    <SolidColorBrush x:Key="AccentBrush"              Color="#0078D4"/>

    <!-- Day cells (Color resources consumed in code-behind) -->
    <SolidColorBrush x:Key="DayNormalTextBrush"       Color="White"/>
    <SolidColorBrush x:Key="DaySatHolidayBrush"       Color="#F87171"/>
    <Color           x:Key="DayHoverOverlayColor"     >#1EFFFFFF</Color>
    <Color           x:Key="DaySelectedOverlayColor"  >#3C0078D4</Color>

    <!-- Nav buttons (∧ ∨) -->
    <SolidColorBrush x:Key="NavButtonForeground"      Color="#9D9D9D"/>
    <SolidColorBrush x:Key="NavButtonHoverBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="NavButtonPressBackground" Color="#3D3D3D"/>

    <!-- Open App / Sign-in button -->
    <SolidColorBrush x:Key="OpenAppForeground"        Color="#0078D4"/>
    <SolidColorBrush x:Key="OpenAppHoverBackground"   Color="#1A0078D4"/>
    <SolidColorBrush x:Key="OpenAppPressBackground"   Color="#260078D4"/>

    <!-- Weekday headers -->
    <SolidColorBrush x:Key="WeekdaySatForeground"    Color="#F87171"/>

</ResourceDictionary>
