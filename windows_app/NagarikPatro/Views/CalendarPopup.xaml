<Window x:Class="NagarikPatro.Views.CalendarPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NagarikPatro.ViewModels"
        Title="Nagarik Patro"
        Width="320" Height="490"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="Transparent">

    <Window.DataContext>
        <vm:CalendarViewModel/>
    </Window.DataContext>

    <Border CornerRadius="8" Background="{DynamicResource PopupBackground}">
        <DockPanel>

            <!-- Live Clock + Date Header -->
            <Border DockPanel.Dock="Top" Padding="20,16,20,12">
                <StackPanel>
                    <TextBlock x:Name="ClockTextBlock"
                               FontFamily="Segoe UI Variable Display, Segoe UI Light, Segoe UI"
                               FontSize="40" FontWeight="Light"
                               Foreground="{DynamicResource ClockForeground}"/>
                    <TextBlock x:Name="AdDateBlock"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               FontSize="13" Foreground="{DynamicResource AccentBrush}"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="BsDateBlock"
                               FontFamily="Nirmala UI" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerBrush}"/>

            <!-- Month Navigation -->
            <Border DockPanel.Dock="Top" Padding="12,8,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MonthHeaderNp}" FontFamily="Nirmala UI"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <TextBlock Text="{Binding MonthHeaderEn}" FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="∧" Click="PreviousMonth_Click"
                                Style="{StaticResource NavButtonStyle}"/>
                        <Button Content="∨" Click="NextMonth_Click"
                                Style="{StaticResource NavButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Open App (bottom-most) -->
            <Button DockPanel.Dock="Bottom" Content="Open Nagarik Patro" Margin="12,6,12,8"
                    Click="OpenApp_Click" Style="{StaticResource OpenAppButtonStyle}"/>

            <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource DividerBrush}"/>

            <!-- Upcoming Google Calendar Events -->
            <StackPanel DockPanel.Dock="Bottom" MaxHeight="120">
                <TextBlock Text="Upcoming" FontSize="11" FontWeight="SemiBold"
                           Margin="12,8,12,4"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>

                <!-- Sign in prompt -->
                <Button Content="Sign in via Nagarik Patro" Margin="12,0,12,6"
                        Click="OpenApp_Click" Style="{StaticResource OpenAppButtonStyle}"
                        Height="26" FontSize="11"
                        Visibility="{Binding ShowGoogleSignInPrompt, Converter={StaticResource BoolToVisibility}}"/>

                <!-- No upcoming events -->
                <TextBlock Text="No upcoming events" FontSize="11" Margin="12,0,12,8"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Visibility="{Binding NoUpcomingGoogleEvents, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Event list -->
                <ItemsControl ItemsSource="{Binding UpcomingGoogleEvents}" Margin="8,0,8,6"
                              Visibility="{Binding HasUpcomingGoogleEvents, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,1" Padding="4,3" CornerRadius="4"
                                    Background="{Binding ColorBrushLight}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                            Margin="0,2,6,2" Background="{Binding ColorBrush}"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="11"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding TimeDisplay}" FontSize="9"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border DockPanel.Dock="Bottom" Height="1" Background="{DynamicResource DividerBrush}"/>

            <!-- Calendar Grid (fills remaining space) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                <StackPanel>
                    <!-- Weekday Headers -->
                    <UniformGrid Rows="1" Columns="7" Margin="12,6,12,2">
                        <TextBlock Text="आ"  Style="{StaticResource WeekdayHeaderStyle}" FontFamily="Nirmala UI"/>
                        <TextBlock Text="सो" Style="{StaticResource WeekdayHeaderStyle}" FontFamily="Nirmala UI"/>
                        <TextBlock Text="मं" Style="{StaticResource WeekdayHeaderStyle}" FontFamily="Nirmala UI"/>
                        <TextBlock Text="बु" Style="{StaticResource WeekdayHeaderStyle}" FontFamily="Nirmala UI"/>
                        <TextBlock Text="बि" Style="{StaticResource WeekdayHeaderStyle}" FontFamily="Nirmala UI"/>
                        <TextBlock Text="शु" Style="{StaticResource WeekdayHeaderStyle}" FontFamily="Nirmala UI"/>
                        <TextBlock Text="श"  Style="{StaticResource WeekdayHeaderSatStyle}" FontFamily="Nirmala UI"/>
                    </UniformGrid>

                    <!-- Calendar days rendered in code-behind -->
                    <UniformGrid x:Name="CalendarGrid" Columns="7" Margin="12,0,12,4"/>

                    <!-- Selected Day Events -->
                    <ItemsControl x:Name="EventsList" Margin="12,4,12,8"
                                  ItemsSource="{Binding SelectedDayEvents}"
                                  Visibility="{Binding HasSelectedDayContent, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Ellipse Width="5" Height="5" Margin="0,4,6,0" VerticalAlignment="Top">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="Orange"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                        <Setter Property="Fill"
                                                                Value="{DynamicResource DaySatHolidayBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel>
                                        <TextBlock Text="{Binding EventNp}" FontSize="12"
                                                   FontFamily="Nirmala UI"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Text="{Binding EventEn}" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

        </DockPanel>
    </Border>
</Window>
