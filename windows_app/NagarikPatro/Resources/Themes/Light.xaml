<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="PopupBackground"          Color="#F3F3F3"/>
    <SolidColorBrush x:Key="DividerBrush"             Color="#DDDDDD"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ClockForeground"          Color="#1A1A1A"/>
    <SolidColorBrush x:Key="PrimaryTextBrush"         Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush"       Color="#555555"/>
    <SolidColorBrush x:Key="AccentBrush"              Color="#0078D4"/>

    <!-- Day cells -->
    <SolidColorBrush x:Key="DayNormalTextBrush"       Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DaySatHolidayBrush"       Color="#C0392B"/>
    <Color           x:Key="DayHoverOverlayColor"     >#1A000000</Color>
    <Color           x:Key="DaySelectedOverlayColor"  >#3C0078D4</Color>

    <!-- Nav buttons -->
    <SolidColorBrush x:Key="NavButtonForeground"      Color="#555555"/>
    <SolidColorBrush x:Key="NavButtonHoverBackground" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="NavButtonPressBackground" Color="#CCCCCC"/>

    <!-- Open App / Sign-in button -->
    <SolidColorBrush x:Key="OpenAppForeground"        Color="#0078D4"/>
    <SolidColorBrush x:Key="OpenAppHoverBackground"   Color="#1A0078D4"/>
    <SolidColorBrush x:Key="OpenAppPressBackground"   Color="#260078D4"/>

    <!-- Weekday headers -->
    <SolidColorBrush x:Key="WeekdaySatForeground"    Color="#C0392B"/>

</ResourceDictionary>
